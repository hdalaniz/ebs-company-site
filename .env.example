# Optional override for the RiseCurrent Insight origin (no trailing slash, no /analyze path).
# Canonical production hostname: https://ebs-insight.vercel.app
# Internal fallback alias: https://ebs-insight-v2.vercel.app
# Local example: http://localhost:3001
# NEXT_PUBLIC_EBS_INSIGHT_URL=

# Server-only commercial lead handoff. Never prefix these with NEXT_PUBLIC_.
# URL defaults to {Insight origin}/api/commercial-leads when unset.
# RISECURRENT_COMMERCIAL_LEAD_URL=
# Shared secret sent as Authorization: Bearer. Required before a submission is forwarded.
# RISECURRENT_COMMERCIAL_LEAD_SECRET=
